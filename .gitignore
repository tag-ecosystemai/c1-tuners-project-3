
# Python Virtual Environments (CRITICAL)
# Never push local binaries/libraries to GitHub

venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL)
# Never commit credentials, DB passwords, API keys

.env
.env.*
!.env.example

# Python Bytecode & Cache
# Auto-generated by Python when files run

__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/


# Local Database Files
# Keep local SQLite/temp testing DBs off Git

*.sqlite
*.sqlite3
*.db

# OS & IDE Metadata
# Local machine clutter

.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Monorepo Frontend & AI Extras (Safe Guard)

node_modules/
.next/
dist/
build/
*.log